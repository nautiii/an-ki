{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(flutter --version *)",
      "PowerShell(flutter --version *)",
      "Bash(dart --version *)",
      "PowerShell(dart --version *)",
      "Bash(flutter gen-l10n)",
      "PowerShell(flutter gen-l10n)",
      "Bash(dart format *)",
      "PowerShell(dart format *)",
      "Bash(flutter analyze *)",
      "PowerShell(flutter analyze *)",
      "Bash(dart analyze *)",
      "PowerShell(dart analyze *)",
      "Bash(flutter test *)",
      "PowerShell(flutter test *)",
      "Bash(bash .claude/hooks/verify-index.sh *)",
      "Bash(bash .claude/hooks/review-model.sh)"
    ],
    "deny": [
      "Read(./secrets.json)",
      "Write(//**/anki-checks/**)",
      "Edit(//**/anki-checks/**)"
    ],
    "ask": [
      "Bash(flutter analyze *--write*)",
      "PowerShell(flutter analyze *--write*)",
      "Bash(flutter test *--file-reporter*)",
      "PowerShell(flutter test *--file-reporter*)",
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(git reset --hard *)",
      "PowerShell(git reset --hard *)",
      "Bash(git clean *)",
      "PowerShell(git clean *)",
      "Bash(git branch -D *)",
      "PowerShell(git branch -D *)",
      "Bash(git stash drop *)",
      "PowerShell(git stash drop *)",
      "Bash(git stash clear *)",
      "PowerShell(git stash clear *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-dart.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
