rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A user can only read/write their own profile document (id == uid).
    match /user/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Groupes privés : seul leur propriétaire les lit et les écrit.
      match /categories/{categoryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Birthdays are owned via the `uid` field.
    match /birthday/{birthdayId} {
      allow read, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
      // Une mise à jour ne peut pas changer le propriétaire du document.
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
    }

    // Scanned books are owned via the `uid` field.
    match /books/{bookId} {
      allow read, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
      // Une mise à jour ne peut pas changer le propriétaire du document.
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
    }

    // Groupes prédéfinis, communs à tous : lus par tout utilisateur connecté,
    // jamais écrits par l'app. Les anciens groupes partagés (sans
    // `predefined`) ne se lisent plus : chacun a sa copie privée.
    match /category/{categoryId} {
      allow read: if request.auth != null
        && resource.data.predefined == true;
    }
  }
}
